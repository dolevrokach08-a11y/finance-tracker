#!/bin/sh
# Blocks a commit whose generated assets are stale.
#
# The app deploys straight from main to GitHub Pages with no build step, so the
# generated files are committed. Forgetting to rebuild after editing a source
# would ship the previous version — loudly for tax-optimizer (the page would run
# old code) and silently for the Tailwind CSS (a new class just wouldn't style).
#
# Enable once per clone:  git config core.hooksPath tools/hooks
#
# The check's own output is printed rather than replaced by a guess at the cause.
# This hook used to announce "a generated file is out of date" whenever --check
# exited non-zero, including when --check had crashed before comparing anything
# and no file was stale at all. Two agents lost a round to that sentence.
out=$(node tools/build-assets.mjs --check 2>&1) || {
  echo "$out"
  echo ""
  echo "Commit blocked: node tools/build-assets.mjs --check did not pass."
  echo "If a file is stale:  node tools/build-assets.mjs   then stage the rebuilt file."
  echo "If the check itself failed, the error above is the reason - not a stale file."
  exit 1
}
echo "$out"
